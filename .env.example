# Local development: point at the LOCAL backend (BE `bun run dev` → wrangler
# dev on :8787, using the staging database). Local dev never talks to
# production — same rule as the BE `.dev.vars` (staging only, never prod).
VITE_API_BASE_URL=http://localhost:8787/api/v1
# Deployed builds: use the real API origin instead, e.g.
#   https://newapi.lbblenteracendekia.com/api/v1   (current prod Worker)
#   https://api.lenteracendekia.id/api/v1          (intended public API domain)
VITE_DEFAULT_TENANT_SLUG=default
VITE_ROOT_DOMAIN=dashboard.lbblenteracendekia.com
